#!/bin/sh
# ai-light — drive the LAN AI status light.
#
# A general ambient status indicator: any tool can push a state, and this
# script arbitrates between concurrent sources before touching the device.
# It knows nothing about Claude Code (see ~/.claude/hooks/ai-light.sh for that).
#
# Each source holds a claim (a one-line file) that expires after --ttl seconds.
# Expiry is evaluated lazily, on the next invocation — there is no timer and no
# daemon. So a stale claim stops *masking other sources* as soon as anything
# calls this script again, but it cannot turn the light off by itself: if the
# only claimant dies and nothing else ever calls in, the device keeps showing
# that last state. Callers that care must `clear` on the way out.
#
# Never fails its caller: it runs inside Claude Code hooks and build pipelines,
# where a non-zero exit would be actively harmful. Usage errors are the one
# exception (exit 2) — those are bugs in the caller, not runtime conditions.

set -u

# One or more devices, space- or comma-separated. The winner is mirrored to
# every host; each keeps its own `.last` so an offline device self-heals on the
# next call rather than being remembered as up to date. The old single-host
# AI_LIGHT_HOST is honored as a fallback.
hosts="${AI_LIGHT_HOSTS:-${AI_LIGHT_HOST:-192.168.2.24}}"
dir="${AI_LIGHT_DIR:-${TMPDIR:-/tmp}/ai-light}"
lockdir="$dir/.lock"

usage() {
  cat >&2 <<'EOF'
usage: ai-light set <state> [--source NAME] [--ttl SECONDS] [--priority normal|alert]
                           [--project NAME] [--tool NAME] [--detail TEXT]
       ai-light clear [--source NAME]
       ai-light status

  <state>      ready thinking working waiting error off   (off retires the source)
  --source     who is speaking. default: default
  --ttl        seconds the claim stays valid. default: 60
  --priority   alert beats normal. default: normal
  --project    label shown alongside the state. default: none
  --tool       what is being run right now, one word. default: none
  --detail     what it is being run on, free text. default: none
EOF
  exit 2
}

# Sources are used as filenames and arrive from callers (a Claude session_id, a
# script's name); keep them to a safe charset rather than trusting them.
sanitize() {
  printf %s "$1" | tr -c 'A-Za-z0-9_-' '_'
}

# Projects are not filenames, so a dot is safe here — and worth allowing, since
# these are usually directory basenames and plenty of those start with one
# (~/.dotfiles). Still URL-safe, which is what spares the query string an
# encoding pass.
sanitize_project() {
  printf %s "$1" | tr -c 'A-Za-z0-9_.-' '_'
}

# `tool` sits mid-line in the claim file, so it has to stay one word. Same
# charset as a project name for the same reason.
#
# 23 bytes is the device's limit for this field, and the two must agree: the
# device rejects an over-long tool by failing the whole request, so cutting here
# to anything longer would turn a long tool name into a dropped state push
# rather than a shortened label. It was 15 until MCP method names turned up --
# browser_navigate is 16, codegraph_context 17, resolve-library-id 18 -- and 15
# silently mangled every one of them.
sanitize_tool() {
  printf %s "$1" | LC_ALL=C tr -c 'A-Za-z0-9_.-' '_' | LC_ALL=C cut -c1-23
}

# `detail` is free text — a shell command, a path, a search pattern — so unlike
# the fields above it keeps its spaces and punctuation and is percent-encoded at
# push time instead. Two hard limits, both of them the device's:
#
#   * printable ASCII only. The display font holds 0x20-0x7E and nothing else,
#     so the device rejects the whole request over one multi-byte character —
#     which would take the state update down with it, not just the label. A
#     Chinese search pattern is an ordinary thing to grep for, so this is a
#     routine case, not a hypothetical one. Dropping bytes rather than
#     transliterating keeps this side dependency-free.
#   * 63 bytes, the width of the console's command row. Truncated here so the
#     claim file cannot hold something the device would refuse.
#
# Control characters go first and unconditionally: a newline would split one
# claim into two lines and desynchronise every positional read below.
#
# LC_ALL=C is what makes the byte ranges mean bytes. Under a UTF-8 locale BSD tr
# matches characters instead, `\177-\377` then fails to cover a multi-byte
# codepoint, and the high bytes sail through to be pushed at the device — which
# is exactly what happened before this was pinned.
sanitize_detail() {
  printf %s "$1" | LC_ALL=C tr -d '\000-\037\177-\377' | LC_ALL=C cut -c1-100
}

# Percent-encode a query value. Space becomes `+`, which the device's
# form_url_decode() reverses; everything outside the unreserved set is escaped,
# because `detail` routinely carries the characters that would otherwise split
# the query (`&`, `=`) or that curl rejects outright (`|`, quotes, braces) — a
# piped shell command hits both groups at once.
#
# One awk pass rather than a shell loop over 63 bytes, and only on the path that
# actually reaches the device: push() skips unchanged payloads before getting
# here. LC_ALL=C so the byte table is not read as multi-byte.
urlencode() {
  printf %s "$1" | LC_ALL=C awk '
    BEGIN {
      RS = "^$"
      for (i = 32; i < 127; i++) code[sprintf("%c", i)] = i
    }
    {
      for (i = 1; i <= length($0); i++) {
        c = substr($0, i, 1)
        if (c ~ /[A-Za-z0-9._~-]/) printf "%s", c
        else if (c == " ") printf "+"
        # Anything not in the table is outside printable ASCII and so cannot
        # have survived sanitize_detail. Dropped rather than encoded, because
        # an absent entry reads as 0 and would emit a literal %00 — an escape
        # the device rejects, taking the state update down with the label.
        else if (c in code) printf "%%%02X", code[c]
      }
    }'
}

valid_state() {
  case "$1" in
    ready | thinking | working | waiting | error | off) return 0 ;;
    *) return 1 ;;
  esac
}

# Run a function with the state dir locked. `mkdir` is atomic on POSIX, which is
# all we need — and unlike flock(1) it actually exists on macOS.
#
# Without this, two hooks firing at once interleave their compute/push/record
# steps: the loser's stale winner lands on the device *after* the winner's, and
# both racing to write `.last` can shred it into a value that is not a state at
# all (observed: "errorng").
#
# A wedged holder is stolen from after ~1s rather than blocking: this runs
# inside hooks, where hanging is worse than a duplicate request.
with_lock() {
  mkdir -p "$dir" 2>/dev/null || return 0

  i=0
  until mkdir "$lockdir" 2>/dev/null; do
    i=$((i + 1))
    if [ "$i" -gt 20 ]; then
      rm -rf "$lockdir" 2>/dev/null
      mkdir "$lockdir" 2>/dev/null || return 0
      break
    fi
    sleep 0.05
  done
  trap 'rm -rf "$lockdir" 2>/dev/null' EXIT HUP INT TERM

  "$1"

  rm -rf "$lockdir" 2>/dev/null
  trap - EXIT HUP INT TERM
}

# Rank helpers. Higher number wins. Printed rather than returned because sh
# exit codes are a terrible place to put data.
urgency() {
  case "$1" in
    error) echo 5 ;;
    waiting) echo 4 ;;
    working) echo 3 ;;
    thinking) echo 2 ;;
    ready) echo 1 ;;
    *) echo 0 ;;
  esac
}

tier() {
  case "$1" in
    alert) echo 2 ;;
    *) echo 1 ;;
  esac
}

# The winning state across all live claims: highest tier, then highest urgency.
# Expired claims are skipped, which is how a killed session releases the light.
#
# No recency tiebreak is needed: urgency is a pure function of the state, so two
# claims that tie on urgency hold the same state and yield the same winner. The
# labels — project, tool, detail — are *not* part of the ranking; they are
# carried along by whichever claim won, so two sources at the same urgency can
# still yield different labels. That tie is broken arbitrarily (directory
# order), same as it always was.
#
# Sets best/best_project/best_tool/best_detail rather than printing them:
# `detail` is free text with spaces in it, so the winner no longer fits in a
# whitespace-separated line the caller can split. Every caller already runs in
# this shell, so globals cost nothing that the old printf was buying.
compute_winner() {
  now=$(date +%s)
  best=off
  best_project=-
  best_tool=-
  best_detail=
  best_tier=0
  best_urgency=0

  for f in "$dir"/*; do
    [ -f "$f" ] || continue
    case "${f##*/}" in .*) continue ;; esac
    # Claims written before these fields existed are short: `read` leaves the
    # missing tail empty and the placeholders below put it back. `detail` is
    # last precisely because it is the one field that may contain spaces —
    # `read` hands the whole remainder of the line to it.
    read -r st ttl prio mt proj tool detail <"$f" || continue
    [ $((now - mt)) -gt "$ttl" ] && continue
    [ -n "$proj" ] || proj=-
    [ -n "$tool" ] || tool=-

    t=$(tier "$prio")
    u=$(urgency "$st")
    if [ "$t" -gt "$best_tier" ] ||
      { [ "$t" -eq "$best_tier" ] && [ "$u" -gt "$best_urgency" ]; }; then
      best="$st"
      best_project="$proj"
      best_tool="$tool"
      best_detail="$detail"
      best_tier="$t"
      best_urgency="$u"
    fi
  done
}

# Send the current winner to each device — but only to those whose payload
# changed. Claude's PreToolUse hook fires on every single tool call; without
# this check the lights would be hammered and the hook would pay a round-trip
# each time.
#
# Short timeout, output discarded, never returns non-zero: an unplugged light
# must not break a build or a hook. Each host gets its own `.last.<host>` file
# recording what it was last known to accept, written only when it really did
# accept — `--fail` is what makes that true, since curl exits 0 on a 4xx/5xx
# body otherwise, and a rejected update would then be remembered as applied and
# never retried. Per-host bookkeeping also means a device that was offline for
# one push is retried on the next call instead of being stranded on a stale
# state because a *different* device already advanced the shared record.
#
# The recorded value is the whole payload — state, project, tool and detail — so
# a run that only changes what Claude is doing still reaches the device.
#
# Note what that costs: PreToolUse fires per tool call, and `detail` changes on
# nearly every one, so the dedupe below no longer absorbs the bulk of them. This
# is the intended trade (a stale detail is worse than no detail) but it does mean
# roughly one LAN round-trip per tool call instead of one per state change.
#
# Callers must hold the lock: this reads and writes the `.last.<host>` files.
push() {
  compute_winner
  new="$best $best_project $best_tool $best_detail"

  url_query="value=$best"
  [ "$best_project" = - ] || url_query="$url_query&project=$best_project"
  [ "$best_tool" = - ] || url_query="$url_query&tool=$(urlencode "$best_tool")"
  [ -z "$best_detail" ] || url_query="$url_query&detail=$(urlencode "$best_detail")"

  for h in $(printf '%s' "$hosts" | tr ',' ' '); do
    hkey=$(sanitize "$h")
    hlast="$dir/.last.$hkey"
    old=$(cat "$hlast" 2>/dev/null) || old=
    [ "$new" = "$old" ] && continue

    if curl -s --fail --max-time 1 "http://$h/state?$url_query" >/dev/null 2>&1; then
      tmp="$dir/.last.$hkey.$$"
      printf '%s' "$new" >"$tmp" 2>/dev/null && mv -f "$tmp" "$hlast" 2>/dev/null
    fi
    # No write on failure → next invocation retries this host, self-healing it.
  done
  return 0
}

cmd_set() {
  [ $# -ge 1 ] || usage
  state="$1"
  shift
  valid_state "$state" || usage

  source=default
  ttl=60
  priority=normal
  project=
  tool=
  detail=
  while [ $# -gt 0 ]; do
    case "$1" in
      --source)
        source="${2:-}"
        shift 2 || usage
        ;;
      --ttl)
        ttl="${2:-}"
        shift 2 || usage
        ;;
      --priority)
        priority="${2:-}"
        shift 2 || usage
        ;;
      --project)
        project="${2:-}"
        shift 2 || usage
        ;;
      --tool)
        tool="${2:-}"
        shift 2 || usage
        ;;
      --detail)
        detail="${2:-}"
        shift 2 || usage
        ;;
      *) usage ;;
    esac
  done
  case "$priority" in normal | alert) ;; *) usage ;; esac

  # A non-numeric ttl used to sail through and write a claim that every later
  # `[ ... -gt ... ]` choked on — and since the comparison errored rather than
  # returning true, the claim was treated as live *forever*. An `alert` one
  # could then mask every other source until the state dir was wiped by hand.
  case "$ttl" in
    '' | *[!0-9]*) usage ;;
  esac
  [ "$ttl" -gt 0 ] || usage

  source=$(sanitize "$source")
  # `-` stands in for "not set", so the leading fields are never empty and the
  # claim always has six whitespace-separated words for `read` to split before
  # the free-text remainder. `detail` needs no placeholder: it is last, so an
  # empty one cannot shift anything.
  if [ -n "$project" ]; then
    project=$(sanitize_project "$project")
  else
    project=-
  fi
  if [ -n "$tool" ]; then
    tool=$(sanitize_tool "$tool")
  else
    tool=-
  fi
  detail=$(sanitize_detail "$detail")
  with_lock apply_set
}

apply_set() {
  if [ "$state" = off ]; then
    rm -f "$dir/$source"
  else
    # Write-then-rename: a concurrent reader never sees a half-written claim.
    tmp="$dir/.tmp.$$"
    printf '%s %s %s %s %s %s %s\n' "$state" "$ttl" "$priority" "$(date +%s)" \
      "$project" "$tool" "$detail" >"$tmp" &&
      mv -f "$tmp" "$dir/$source"
  fi

  push
}

cmd_clear() {
  source=default
  while [ $# -gt 0 ]; do
    case "$1" in
      --source)
        source="${2:-}"
        shift 2 || usage
        ;;
      *) usage ;;
    esac
  done
  source=$(sanitize "$source")
  with_lock apply_clear
}

apply_clear() {
  rm -f "$dir/$source"
  push
}

cmd_status() {
  now=$(date +%s)
  for f in "$dir"/*; do
    [ -f "$f" ] || continue
    read -r st ttl prio mt proj tool detail <"$f" || continue
    [ $((now - mt)) -gt "$ttl" ] && continue
    [ -n "$proj" ] || proj=-
    [ -n "$tool" ] || tool=-
    printf 'source %s %s %s %s %s %s %s\n' "${f##*/}" "$st" "$prio" "$ttl" \
      "$proj" "$tool" "${detail:--}"
  done
  compute_winner
  printf 'winner: %s %s %s %s\n' "$best" "$best_project" "$best_tool" \
    "${best_detail:--}"
}

[ $# -ge 1 ] || usage
subcommand="$1"
shift
case "$subcommand" in
  set) cmd_set "$@" ;;
  clear) cmd_clear "$@" ;;
  status) cmd_status "$@" ;;
  *) usage ;;
esac
exit 0
