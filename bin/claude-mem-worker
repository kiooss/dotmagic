#!/usr/bin/env bash
# claude-mem-worker — run claude-mem's worker daemon with a fixed Bedrock env.
#
# Why this exists: claude-mem normally starts the worker from its SessionStart
# hook, and the worker inherits that session's env wholesale (`bg()` spawns with
# `{...process.env}`, and `np()` later hands the same env to the `claude` CLI it
# shells out to, stripping only ANTHROPIC_API_KEY and CLAUDECODE). Because
# cc-bedrock() in dotconfig/zsh/.zshrc deliberately does NOT export its Bedrock
# vars, whether observations bill Bedrock or the subscription came down to which
# wrapper happened to launch the session that first booted the worker — and the
# worker then lives for days on that choice. Failures are silent: a hit session
# limit just leaves rows in pending_messages with status=failed, retry_count=0.
#
# So launchd owns the worker instead, and this script pins its env. Interactive
# sessions keep using cc-pro / cc-bedrock freely; the worker is unaffected.
#
# Run via ~/Library/LaunchAgents/co.kiooss.claude-mem-worker.plist, not by hand.
# That plist is intentionally NOT tracked here (machine-local, absolute paths),
# so it is invisible to this repo — on a new machine it has to be written by
# hand: Label co.kiooss.claude-mem-worker, ProgramArguments = this script,
# RunAtLoad + KeepAlive true, then
#   launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/<label>.plist
#
# `--daemon` is the foreground mode and the only one launchd can supervise:
# `start` spawns a detached setsid child and exits, which KeepAlive would read
# as a crash and restart forever.
#
# The plugin's own hook still runs `worker-service.cjs start` every session;
# that sees a live worker.pid, throws "Worker already running", and the hook
# (no set -e) falls through to its /health check and passes. No double worker.
# The flip side: after any bootstrap/bootout the hooks win the restart race
# within seconds, so take ownership back explicitly —
#   <plugin>/scripts/worker-service.cjs stop
#   launchctl kickstart -k gui/$(id -u)/co.kiooss.claude-mem-worker
#
# Usage: claude-mem-worker [--print-env]
#   --print-env  show the resolved paths and env, run nothing

set -euo pipefail

plugin_root=$(ls -dt "$HOME"/.claude/plugins/cache/thedotmack/claude-mem/[0-9]*/ 2>/dev/null | head -1)
plugin_root="${plugin_root%/}"
[ -n "$plugin_root" ] || { echo "claude-mem-worker: no claude-mem plugin found" >&2; exit 1; }

worker="$plugin_root/scripts/worker-service.cjs"
[ -f "$worker" ] || { echo "claude-mem-worker: missing $worker" >&2; exit 1; }

# The worker requires Bun specifically — it imports bun:sqlite.
bun="$HOME/.bun/bin/bun"
[ -x "$bun" ] || bun=$(command -v bun 2>/dev/null || true)
[ -n "$bun" ] || { echo "claude-mem-worker: bun not found (see https://bun.sh)" >&2; exit 1; }

# launchd gives us a minimal PATH, but the worker shells out to `claude`, `uv`
# (chroma-mcp) and `node` (mcp-server.cjs), so rebuild one. nvm lives under
# .config here, not ~/.nvm — the plugin's own hook guesses ~/.nvm and silently
# resolves to nothing.
nvm_dir="$HOME/.config/nvm/versions/node"
node_bin=""
if [ -d "$nvm_dir" ]; then
    newest=$(ls "$nvm_dir" 2>/dev/null | sed 's/^v//' \
        | sort -t. -k1,1n -k2,2n -k3,3n | tail -1)
    [ -n "$newest" ] && node_bin="$nvm_dir/v$newest/bin"
fi
PATH="${node_bin:+$node_bin:}$HOME/.local/bin:$HOME/.bun/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export PATH

# Bedrock, pinned. Only the profile NAME lives here — no credentials; the AWS
# CLI resolves them from ~/.aws, which this script never reads.
export CLAUDE_CODE_USE_BEDROCK=1
export AWS_PROFILE=claude-bedrock
export AWS_REGION=ap-northeast-1
export ANTHROPIC_DEFAULT_HAIKU_MODEL='jp.anthropic.claude-haiku-4-5-20251001-v1:0'
export ANTHROPIC_DEFAULT_SONNET_MODEL='jp.anthropic.claude-sonnet-5'
export ANTHROPIC_DEFAULT_OPUS_MODEL='global.anthropic.claude-opus-5'

# Match what bg() sets, so the port can't drift from settings.json.
export CLAUDE_MEM_WORKER_PORT=37777

if [ "${1:-}" = "--print-env" ]; then
    echo "plugin_root : $plugin_root"
    echo "bun         : $bun"
    echo "node_bin    : ${node_bin:-<none>}"
    echo "PATH        : $PATH"
    env | grep -E '^(CLAUDE_CODE_USE_BEDROCK|AWS_PROFILE|AWS_REGION|ANTHROPIC_DEFAULT_|CLAUDE_MEM_WORKER_PORT)' | sort
    exit 0
fi

exec "$bun" "$worker" --daemon
